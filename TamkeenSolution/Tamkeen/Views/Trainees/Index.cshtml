@model List<Tamkeen.Domain.Entities.Trainee>

@{
    ViewData["Title"] = "إدارة المتدربين";
}

<style>
    :root {
        --glass-bg: rgba(255, 255, 255, 0.95);
        --border-radius-lg: 1.25rem;
    }

    body {
        background-color: #f8fafc;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .dashboard-card {
        background: var(--glass-bg);
        border: 1px solid #edf2f7;
        border-radius: var(--border-radius-lg);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .table-hover tbody tr:hover {
        background-color: #f1f5f9;
        transition: background-color 0.2s ease;
    }

    .badge-status {
        font-weight: 700;
        padding: 0.5em 1em;
        font-size: 0.75rem;
        border-radius: 50px;
    }

    /* تنسيق شريط البحث للعربية */
    .search-group .form-control {
        border-radius: 0 25px 25px 0;
        padding-right: 1.5rem;
        border-left: 0;
    }

    .search-group .btn {
        border-radius: 25px 0 0 25px;
        padding-left: 1.5rem;
        border-right: 0;
    }

    .btn-pill {
        border-radius: 50px;
        padding: 0.6rem 1.5rem;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .avatar-circle {
        width: 42px;
        height: 42px;
        background: #e2e8f0;
        color: #475569;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 0.9rem;
    }
</style>

<div class="container-fluid py-4 text-end">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="fw-bold text-dark mb-1">إدارة المتدربين</h2>
            <p class="text-muted mb-0">إدارة ومراقبة بيانات المتدربين عبر جميع الأقسام والبرامج</p>
        </div>
        <div class="col-md-6 text-md-start mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary btn-pill shadow-sm">
                <i class="bi bi-person-plus ms-1"></i> إضافة متدرب جديد
            </a>
        </div>
    </div>

    <div class="dashboard-card p-3 mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="input-group search-group">
                    <input type="text" class="form-control" placeholder="ابحث بالاسم أو الجامعة..." aria-label="Search">
                    <button class="btn btn-primary" type="button">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select rounded-pill border-light shadow-sm fw-bold text-secondary" style="font-size: 0.9rem;">
                    <option value="" selected>🔍 جميع الحالات</option>
                    <option value="1">متقدم جديد (Applicant)</option>
                    <option value="2">نشط حالياً (Active)</option>
                    <option value="3">أتم البرنامج (Completed)</option>
                    <option value="4">موقوف مؤقتاً (Suspended)</option>
                    <option value="5">مرفوض (Rejected)</option>
                </select>
            </div>
        </div>
    </div>

    <div class="dashboard-card shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th class="pr-4 border-0 text-secondary small fw-bold py-3" style="padding-right: 1.5rem;">اسم المتدرب</th>
                        <th class="border-0 text-secondary small fw-bold py-3">الجامعة</th>
                        <th class="border-0 text-secondary small fw-bold py-3">المعدل (GPA)</th>
                        <th class="border-0 text-secondary small fw-bold py-3">الحالة</th>
                        <th class="border-0 text-secondary small fw-bold py-3 text-start pl-4" style="padding-left: 1.5rem;">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var trainee in Model)
                        {
                            <tr>
                                <td style="padding-right: 1.5rem;">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle ms-3 bg-primary text-white">
                                            @trainee.User.FullName.Substring(0, 1)
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@trainee.User.FullName</div>
                                            <div class="small text-muted">@trainee.User.UserInfo.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted"><i class="bi bi-mortarboard ms-1"></i> @trainee.University</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@trainee.GPA</span>
                                </td>
                                <td>
                                    @{
                                        // بناءً على Enum TraineeStatus المحدث
                                        var (statusLabel, statusClass) = trainee.Status switch
                                        {
                                            Tamkeen.Domain.Enums.TraineeStatus.Applicant => ("متقدم جديد", "bg-primary-subtle text-primary"),
                                            Tamkeen.Domain.Enums.TraineeStatus.Active => ("نشط حالياً", "bg-success-subtle text-success"),
                                            Tamkeen.Domain.Enums.TraineeStatus.Completed => ("أتم البرنامج", "bg-info-subtle text-info"),
                                            Tamkeen.Domain.Enums.TraineeStatus.Suspended => ("موقوف مؤقتاً", "bg-warning-subtle text-warning"),
                                            Tamkeen.Domain.Enums.TraineeStatus.Rejected => ("مرفوض", "bg-danger-subtle text-danger"),
                                            _ => ("غير محدد", "bg-light text-dark")
                                        };
                                    }

                                    <span class="badge badge-status @statusClass shadow-sm border">
                                        <i class="bi bi-circle-fill ms-1" style="font-size: 0.5rem;"></i> @statusLabel
                                    </span>
                                    <span class="badge badge-status @statusClass">
                                        @statusLabel
                                    </span>
                                </td>
                                <td class="text-start" style="padding-left: 1.5rem;">
                                    <div class="btn-group bg-white border rounded-pill p-1">
                                        <a asp-action="Details" asp-route-id="@trainee.Id" class="btn btn-link btn-sm text-primary px-2" title="عرض التفاصيل">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@trainee.Id" class="btn btn-link btn-sm text-warning px-2" title="تعديل">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" class="btn btn-link btn-sm text-danger px-2" title="إلغاء التنشيط">
                                            <i class="bi bi-person-x-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-5 text-center">
                                <div class="text-muted">
                                    <i class="bi bi-people display-4 opacity-25"></i>
                                    <h5 class="mt-3">لا يوجد متدربون حالياً</h5>
                                    <p class="small">ابدأ بإضافة أول متدرب إلى النظام عبر الزر أعلاه.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-top-0 py-3">
            <div class="row align-items-center">
                <div class="col-sm-6 text-center text-sm-end">
                    <span class="text-muted small">عرض 1 إلى @Model?.Count من أصل @Model?.Count مدخلات</span>
                </div>
                <div class="col-sm-6 mt-3 mt-sm-0">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm justify-content-center justify-content-sm-start mb-0">
                            <li class="page-item disabled"><a class="page-link border-0 rounded-circle mx-1" href="#"><i class="bi bi-chevron-right"></i></a></li>
                            <li class="page-item active"><a class="page-link border-0 rounded-circle mx-1" href="#">1</a></li>
                            <li class="page-item"><a class="page-link border-0 rounded-circle mx-1" href="#">2</a></li>
                            <li class="page-item"><a class="page-link border-0 rounded-circle mx-1" href="#"><i class="bi bi-chevron-left"></i></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>