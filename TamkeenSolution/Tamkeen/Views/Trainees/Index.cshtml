@model List<Tamkeen.Domain.Entities.Trainee>

@{
    ViewData["Title"] = "Trainees Management";
}

<style>
    :root {
        --glass-bg: rgba(255, 255, 255, 0.95);
        --border-radius-lg: 1rem;
    }

    body {
        background-color: #f8f9fc;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .dashboard-card {
        background: var(--glass-bg);
        border: none;
        border-radius: var(--border-radius-lg);
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        transition: transform 0.2s ease;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.04);
        cursor: pointer;
    }

    .badge-status {
        font-weight: 600;
        padding: 0.5em 0.8em;
        font-size: 0.75rem;
    }

    .search-group .form-control {
        border-radius: 20px 0 0 20px;
        padding-left: 1.5rem;
    }

    .search-group .btn {
        border-radius: 0 20px 20px 0;
        padding-right: 1.5rem;
    }

    .btn-pill {
        border-radius: 50px;
        padding: 0.5rem 1.25rem;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .empty-state {
        padding: 5rem 1rem;
        text-align: center;
    }
</style>

<div class="container-fluid py-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="fw-bold text-dark mb-1">Trainees Management</h2>
            <p class="text-muted mb-0">Manage and monitor trainee information across all departments</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary btn-pill shadow-sm">
                <i class="bi bi-plus-lg"></i> Create New Trainee
            </a>
        </div>
    </div>

    <div class="dashboard-card p-3 mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="input-group search-group">
                    <input type="text" class="form-control border-end-0" placeholder="Search by name or university..." aria-label="Search">
                    <button class="btn btn-outline-secondary border-start-0" type="button">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select rounded-pill">
                    <option selected>All Statuses</option>
                    <option>Active</option>
                    <option>Inactive</option>
                    <option>Pending</option>
                </select>
            </div>
        </div>
    </div>

    <div class="dashboard-card shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 border-0 text-uppercase text-secondary small fw-bolder">Trainee Name</th>
                        <th class="border-0 text-uppercase text-secondary small fw-bolder">University</th>
                        <th class="border-0 text-uppercase text-secondary small fw-bolder">GPA</th>
                        <th class="border-0 text-uppercase text-secondary small fw-bolder">Status</th>
                        <th class="border-0 text-uppercase text-secondary small fw-bolder text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var trainee in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-3 bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            @trainee.User.FullName.Substring(0, 1)
                                        </div>
                                        <div class="fw-bold text-dark">@trainee.User.FullName</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted"><i class="bi bi-bank me-1"></i> @trainee.University</span>
                                </td>
                                <td>
                                    <span class="fw-medium text-dark">@trainee.GPA</span>
                                </td>
                                <td>
                                    @{
                                        var statusClass = trainee.Status.ToString().ToLower() switch
                                        {
                                            "active" => "bg-success-subtle text-success",
                                            "inactive" => "bg-secondary-subtle text-secondary",
                                            "pending" => "bg-warning-subtle text-warning",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge rounded-pill badge-status @statusClass">
                                        @trainee.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm rounded-pill bg-white">
                                        <a asp-action="Details" asp-route-id="@trainee.Id" class="btn btn-outline-light text-primary border-0 btn-sm px-3" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@trainee.Id" class="btn btn-outline-light text-warning border-0 btn-sm px-3" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-light text-danger border-0 btn-sm px-3" title="Deactivate">
                                            <i class="bi bi-person-x"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <i class="bi bi-people text-muted display-4"></i>
                                    <h5 class="mt-3 text-muted">No trainees found</h5>
                                    <p class="small text-secondary">Try adjusting your filters or add a new trainee to get started.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-0 py-3">
            <div class="row align-items-center">
                <div class="col-sm-6 text-center text-sm-start">
                    <span class="text-muted small">Showing 1 to @Model.Count of @Model.Count entries</span>
                </div>
                <div class="col-sm-6 mt-3 mt-sm-0">
                    <nav aria-label="Table navigation">
                        <ul class="pagination pagination-sm justify-content-center justify-content-sm-end mb-0">
                            <li class="page-item disabled"><a class="page-link border-0 rounded-circle mx-1" href="#"><i class="bi bi-chevron-left"></i></a></li>
                            <li class="page-item active"><a class="page-link border-0 rounded-circle mx-1" href="#">1</a></li>
                            <li class="page-item"><a class="page-link border-0 rounded-circle mx-1" href="#">2</a></li>
                            <li class="page-item"><a class="page-link border-0 rounded-circle mx-1" href="#"><i class="bi bi-chevron-right"></i></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>