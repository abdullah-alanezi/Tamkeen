@model Tamkeen.Domain.Entities.Trainee

@{
    ViewData["Title"] = "Edit Trainee Profile";
}

<style>
    .form-card {
        background: #ffffff;
        border-radius: 1.25rem;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
    }

    .form-section-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #4e73df;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .input-group-modern {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .input-group-modern i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #a0aec0;
        z-index: 10;
    }

    .input-group-modern .form-control {
        padding-left: 45px;
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        transition: all 0.2s ease;
        height: 50px;
    }

    .input-group-modern .form-control:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 4px rgba(78, 115, 223, 0.1);
        background-color: #fff;
    }

    .sticky-actions {
        position: sticky;
        bottom: 2rem;
        z-index: 100;
    }

    .action-bar {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 100px;
        padding: 0.75rem 1.5rem;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h2 class="fw-bold text-dark mb-1">Edit Trainee</h2>
                    <p class="text-muted small">Update academic records for <strong>@Model.User?.FullName</strong></p>
                </div>
                <a asp-action="Index" class="btn btn-link text-decoration-none text-secondary small">
                    <i class="bi bi-x-lg me-1"></i> Cancel
                </a>
            </div>

            <form asp-action="Edit" method="post" class="needs-validation">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>
                <input type="hidden" asp-for="Id" />

                <div class="form-card p-4 p-md-5 mb-4">
                    <div class="form-section-title">
                        <i class="bi bi-mortarboard-fill"></i>
                        Academic Information
                    </div>

                    <div class="row">
                        <div class="col-12 mb-4">
                            <label asp-for="University" class="form-label fw-semibold small ms-1">University Name</label>
                            <div class="input-group-modern">
                                <i class="bi bi-bank"></i>
                                <input asp-for="University" class="form-control" placeholder="e.g. King Saud University" />
                            </div>
                            <span asp-validation-for="University" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8 mb-4">
                            <label asp-for="Major" class="form-label fw-semibold small ms-1">Field of Study (Major)</label>
                            <div class="input-group-modern">
                                <i class="bi bi-book"></i>
                                <input asp-for="Major" class="form-control" placeholder="e.g. Software Engineering" />
                            </div>
                            <span asp-validation-for="Major" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-4">
                            <label asp-for="GPA" class="form-label fw-semibold small ms-1">Current GPA</label>
                            <div class="input-group-modern">
                                <i class="bi bi-graph-up-arrow"></i>
                                <input asp-for="GPA" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="GPA" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3">
                        <div class="d-flex gap-3">
                            <i class="bi bi-shield-check text-primary fs-4"></i>
                            <div>
                                <h6 class="mb-1 fw-bold small">Data Integrity</h6>
                                <p class="mb-0 text-muted extra-small" style="font-size: 0.75rem;">
                                    Ensure the GPA matches the official transcript. Changes are logged for audit purposes.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="sticky-actions d-flex justify-content-center">
                    <div class="action-bar d-flex align-items-center gap-3">
                        <span class="text-muted small d-none d-md-inline pe-3 border-end">Unsaved Changes</span>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 btn-sm fw-bold">Discard</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 btn-sm fw-bold shadow">
                            <i class="bi bi-check2-circle me-2"></i> Save Trainee Profile
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
