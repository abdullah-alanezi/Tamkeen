@model Tamkeen.Domain.Entities.Trainee

@{
    ViewData["Title"] = "Trainee Profile";
}

<style>
    .profile-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 1rem 1rem 0 0;
        height: 120px;
    }

    .profile-avatar-wrapper {
        margin-top: -60px;
        padding-left: 2rem;
    }

    .profile-avatar {
        width: 120px;
        height: 120px;
        border: 5px solid #fff;
        background-color: #f8f9fa;
        font-size: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1);
    }

    .detail-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.05);
        height: 100%;
    }

    .info-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #6c757d;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .info-value {
        font-size: 1rem;
        color: #2d3436;
        font-weight: 500;
    }

    .status-indicator {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Trainees</a></li>
                <li class="breadcrumb-item active">@Model.User.FullName</li>
            </ol>
        </nav>
        <div class="btn-group">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-4 me-2">
                <i class="bi bi-pencil me-2"></i>Edit Profile
            </a>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4 overflow-hidden rounded-4">
        <div class="profile-header"></div>
        <div class="profile-avatar-wrapper d-flex align-items-end mb-3">
            <div class="profile-avatar rounded-circle text-primary fw-bold">
                @Model.User.FullName.Substring(0, 1)
            </div>
            <div class="ms-4 mb-2">
                <h2 class="fw-bold mb-0">@Model.User.FullName</h2>
                <span class="text-muted">
                    <i class="bi bi-geo-alt me-1"></i> @Model.University Student
                </span>
            </div>
        </div>
        
        <div class="card-body pt-0 px-4 pb-4">
            <hr class="text-muted opacity-25">
            <div class="row g-4">
                <div class="col-6 col-md-3">
                    <div class="info-label">Status</div>
                    <div>
                        @{
                            var statusColor = Model.Status.ToString().ToLower() == "active" ? "bg-success" : "bg-warning";
                        }
                        <span class="status-indicator @statusColor"></span>
                        <span class="fw-bold">@Model.Status</span>
                    </div>
                </div>
                <div class="col-6 col-md-3 border-start-md">
                    <div class="info-label">GPA Score</div>
                    <div class="info-value text-primary fw-bold">@Model.GPA / 4.0</div>
                </div>
                <div class="col-6 col-md-3 border-start-md">
                    <div class="info-label">Current Major</div>
                    <div class="info-value">@Model.Major</div>
                </div>
                <div class="col-6 col-md-3 border-start-md">
                    <div class="info-label">Join Date</div>
                    <div class="info-value">Feb 2026</div> </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card detail-card p-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary-subtle p-2 rounded-3 me-3">
                        <i class="bi bi-book text-primary fs-4"></i>
                    </div>
                    <h5 class="mb-0 fw-bold">Academic Overview</h5>
                </div>
                
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="info-label">University Name</label>
                        <p class="info-value">@Model.University</p>
                    </div>
                    <div class="col-md-6">
                        <label class="info-label">Academic Department</label>
                        <p class="info-value">School of Engineering</p>
                    </div>
                    <div class="col-md-12">
                        <label class="info-label">Specialization</label>
                        <p class="info-value">@Model.Major</p>
                    </div>
                </div>

                <div class="mt-4 p-3 bg-light rounded-3 d-flex align-items-center">
                    <i class="bi bi-info-circle-fill text-primary me-3"></i>
                    <small class="text-muted">This trainee has maintained a consistent GPA above the program average for the last two semesters.</small>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card detail-card p-4">
                <h5 class="fw-bold mb-3">Quick Actions</h5>
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-secondary btn-sm text-start py-2">
                        <i class="bi bi-envelope me-2"></i> Send Message
                    </button>
                    <button class="btn btn-outline-secondary btn-sm text-start py-2">
                        <i class="bi bi-file-earmark-pdf me-2"></i> Export Report
                    </button>
                    <hr>
                    <button class="btn btn-danger btn-sm py-2 rounded-pill">
                        <i class="bi bi-person-x me-2"></i> Deactivate Account
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
