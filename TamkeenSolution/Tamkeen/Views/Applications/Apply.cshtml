@model Tamkeen.Models.ViewModels.ApplicationViewModel;
@{
    Tamkeen.Domain.Entities.ProgramPost posts = ViewBag.Program;
    Layout = "_AuthLayout";
}

<div class="container py-5 text-end" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-11 col-xl-10">
            <div class="card overflow-hidden border-0 shadow-lg animate__animated animate__fadeIn" style="border-radius: 20px;">
                <div class="row g-0">

                    <div class="col-md-5 bg-dark text-white p-4 p-lg-5 d-flex flex-column justify-content-between position-relative" style="background: linear-gradient(145deg, #1a1a1a 0%, #2d2d2d 100%);">
                        <div class="position-absolute top-0 start-0 w-100 h-100 opacity-10" style="background-image: url('https://www.transparenttextures.com/patterns/carbon-fibre.png');"></div>

                        <div class="position-relative">
                            <a href="javascript:history.back()" class="btn btn-sm btn-outline-light mb-4 rounded-pill opacity-75">
                                <i class="bi bi-arrow-right ms-1"></i> العودة
                            </a>
                            <h6 class="text-primary text-uppercase fw-bold mb-2" style="letter-spacing: 1px;">برنامج تدريبي</h6>
                            <h2 class="display-6 fw-bold mb-4">@posts.trainingProgram.Name</h2>

                            <div class="mb-5">
                                <p class="text-light opacity-75 lh-lg">@posts.trainingProgram.Description</p>
                            </div>

                            <div class="info-badges">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="icon-box bg-primary rounded-3 ms-3">
                                        <i class="bi bi-calendar-event p-2"></i>
                                    </div>
                                    <div>
                                        <small class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">الفترة الزمنية</small>
                                        <span class="small">@posts.trainingProgram.StartDate.ToString("dd MMM") - @posts.trainingProgram.EndDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-box bg-success rounded-3 ms-3">
                                        <i class="bi bi-people p-2"></i>
                                    </div>
                                    <div>
                                        <small class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">المقاعد المتاحة</small>
                                        <span>إجمالي @posts.trainingProgram.Capacity مقعد</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 pt-4 border-top border-secondary position-relative">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="flex-grow-1 me-3">
                                    <small class="text-muted d-block mb-1">نسبة الإقبال الحالية</small>
                                    <div class="progress" style="height: 6px; background: #444; direction: ltr;">
                                        @{
                                            var percent = posts.trainingProgram.Capacity > 0
                                            ? (posts.application?.Count ?? 0) * 100 / posts.trainingProgram.Capacity
                                            : 0;
                                        }
                                        <div class="progress-bar bg-primary" style="width: @percent%"></div>
                                    </div>
                                </div>
                                <span class="fw-bold text-primary">@posts.application?.Count</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-7 p-4 p-lg-5 bg-white text-end">
                        <div class="mb-4">
                            <h3 class="fw-bold text-dark">تقديم طلب انضمام</h3>
                            <p class="text-muted">يرجى تعبئة بياناتك الأكاديمية بدقة لإتمام الطلب.</p>
                        </div>

                        <form asp-action="SubmitApplication" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="id" value="@posts.Id" />

                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold small text-muted">الاسم الكامل</label>
                                    <input type="text" asp-for="FullName" class="form-control custom-input" placeholder="أدخل اسمك كما في الهوية" required>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label fw-bold small text-muted">البريد الإلكتروني</label>
                                    <input type="email" asp-for="Email" class="form-control custom-input text-start" dir="ltr" placeholder="name@example.com" required>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">الجامعة / الكلية</label>
                                    <input type="text" asp-for="University" class="form-control custom-input" placeholder="اسم جامعتك" required>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">التخصص</label>
                                    <input type="text" asp-for="Major" class="form-control custom-input" placeholder="مثلاً: علوم حاسب" required>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label fw-bold small text-muted">السيرة الذاتية (ملف PDF فقط)</label>
                                    <div class="cv-upload-container position-relative">
                                        <input type="file" asp-for="CVFile" class="form-control position-absolute opacity-0 w-100 h-100" style="z-index: 5; cursor: pointer;" accept=".pdf" id="cvInput" required>
                                        <div class="cv-placeholder border rounded-3 p-4 text-center bg-light transition-all">
                                            <i class="bi bi-cloud-arrow-up fs-1 text-primary mb-2 d-block"></i>
                                            <span id="fileName" class="text-secondary small">اسحب الملف هنا أو اضغط لرفع السيرة الذاتية</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill mt-4 py-3 fw-bold shadow-sm">
                                إرسال الطلب الآن <i class="bi bi-send-fill me-2"></i>
                            </button>
                        </form>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success mt-3 rounded-3 border-0 shadow-sm animate__animated animate__shakeX">
                                <i class="bi bi-check-circle-fill ms-2"></i> @TempData["SuccessMessage"]
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-input {
        padding: 0.75rem 1rem;
        background-color: #f8f9fa;
        border: 1px solid #eee;
        border-radius: 12px;
        transition: 0.3s;
    }

        .custom-input:focus {
            background-color: #fff;
            border-color: #4f46e5;
            box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.1);
        }

    .icon-box i {
        font-size: 1.2rem;
        color: white;
    }

    .cv-upload-container:hover .cv-placeholder {
        border-color: #4f46e5;
        background-color: #f1f7ff !important;
        transform: scale(1.01);
    }

    .bg-primary {
        background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%) !important;
    }

    .transition-all {
        transition: all 0.3s ease;
    }
</style>

<script>
    document.getElementById('cvInput').onchange = function () {
        const fileName = this.files[0] ? this.files[0].name : "لم يتم اختيار ملف";
        const placeholder = document.getElementById('fileName');
        placeholder.innerHTML = fileName;
        placeholder.classList.replace('text-secondary', 'text-primary');
        placeholder.classList.add('fw-bold');
    };
</script>