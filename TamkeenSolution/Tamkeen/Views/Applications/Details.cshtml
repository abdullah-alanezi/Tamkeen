@model Tamkeen.Domain.Entities.ProgramPost


<div class="container-fluid py-4" style="background-color: #f8fafc; min-height: 100vh;">
    
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 15px;">
                <div class="card-body p-0">
                    <div class="bg-primary p-4 text-white d-md-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-white text-primary mb-2 fw-bold">Active Training Program</span>
                            <h1 class="display-6 fw-bold mb-0">@Model.trainingProgram.Name</h1>
                            <p class="opacity-75 mb-0">@Model.trainingProgram.Description</p>
                        </div>
                        <div class="mt-3 mt-md-0">
                            <button class="btn btn-light fw-bold px-4 rounded-pill shadow-sm">
                                <i class="bi bi-pencil-square me-2"></i>Edit Program
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted fw-bold small mb-3">Program Stats</h6>
                    
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-2 bg-info bg-opacity-10 rounded-3 me-3">
                            <i class="bi bi-people-fill text-info fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Applications</small>
                            <span class="fw-bold fs-5">@Model.application.Count()</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-3">
                        <div class="p-2 bg-success bg-opacity-10 rounded-3 me-3">
                            <i class="bi bi-pie-chart-fill text-success fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Capacity</small>
                            <span class="fw-bold fs-5">@Model.trainingProgram.Capacity Seats</span>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25">

                    <h6 class="text-uppercase text-muted fw-bold small mb-3">Timeline</h6>
                    <div class="small">
                        <div class="mb-2">
                            <i class="bi bi-calendar-check me-2 text-primary"></i>
                            <strong>Starts:</strong> @Model.trainingProgram.StartDate.ToString("MMM dd, yyyy")
                        </div>
                        <div>
                            <i class="bi bi-calendar-x me-2 text-danger"></i>
                            <strong>Ends:</strong> @Model.trainingProgram.EndDate.ToString("MMM dd, yyyy")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold">Applicants Queue</h5>
                        <div class="input-group w-25">
                             <input type="text" class="form-control form-control-sm border-light bg-light" placeholder="Search...">
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-uppercase text-muted">
                                <th class="ps-4">Full Name & Contact</th>
                                <th>University / Major</th>
                                <th>Status</th>
                                <th>Document</th>
                                <th class="text-end pe-4">Manage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.application != null && Model.application.Any())
                            {
                                @foreach (var app in Model.application)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold me-3" style="width: 40px; height: 40px;">
                                                    @app.FullName.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <div class="fw-bold">@app.FullName</div>
                                                    <small class="text-muted">@app.Email</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold">@app.University</div>
                                            <div class="text-muted small">@app.Major</div>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill bg-warning-subtle text-warning px-3 py-2 border border-warning border-opacity-25">
                                                @app.Status
                                            </span>
                                        </td>
                                        <td>
                                            <a href="/uploads/@app.CVPath" target="_blank" class="btn btn-sm btn-light border text-danger">
                                                <i class="bi bi-file-earmark-pdf-fill me-1"></i>CV
                                            </a>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-action="ApplicationDetail" asp-route-id ="@app.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Review</a>
                                        </td>
                                    </tr>
                                    
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                                        No applications received yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    .table thead th { font-weight: 600; font-size: 0.8rem; letter-spacing: 0.025em; }
    .card { transition: all 0.3s ease; }
    .bg-primary { background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%) !important; }
</style>