@model List<Tamkeen.Domain.Entities.ProgramPost>

@{
    ViewData["Title"] = "إدارة طلبات الالتحاق";
}

<style>
    .app-card {
        background: #ffffff;
        border-radius: 1rem;
        border: 1px solid #eef2f7;
        transition: all 0.3s ease;
    }

        .app-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 20px rgba(0,0,0,0.05);
        }

    .stat-badge {
        font-size: 0.8rem;
        padding: 0.5rem 1rem;
        border-radius: 50px;
    }
</style>

<div class="container py-4 text-end">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">طلبات الالتحاق بالبرامج</h2>
            <p class="text-muted">مراجعة وإدارة طلبات المتقدمين للبرامج التدريبية المتاحة</p>
        </div>
        <div class="bg-primary-subtle text-primary p-3 rounded-4">
            <h4 class="mb-0 fw-bold">@Model.Count</h4>
            <small>برنامج متاح</small>
        </div>
    </div>

    <div class="table-responsive dashboard-card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="border-0 py-3 pr-4" style="padding-right: 1.5rem;">اسم البرنامج التدريبي</th>
                    <th class="border-0 py-3">السعة الاستيعابية</th>
                    <th class="border-0 py-3">تاريخ الانتهاء</th>
                    <th class="border-0 py-3">حالة الاستقبال</th>
                    <th class="border-0 py-3 text-center">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model)
                {
                    <tr>
                        <td style="padding-right: 1.5rem;">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary text-white rounded-3 p-2 ms-3">
                                    <i class="bi bi-journal-text"></i>
                                </div>
                                <span class="fw-bold text-dark">@app.trainingProgram.Name</span>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <span class="badge bg-light text-dark border ms-2">@app.trainingProgram.Capacity</span>
                                <small class="text-muted">مقعد متاح</small>
                            </div>
                        </td>
                        <td>
                            <span class="text-muted">
                                <i class="bi bi-calendar-x ms-1"></i>
                                @app.trainingProgram.EndDate.ToString("yyyy/MM/dd")
                            </span>
                        </td>
                        <td>
                            @{
                                // منطق بسيط لتحديد الحالة بناءً على التاريخ
                                var isOpen = app.trainingProgram.EndDate >= DateTime.Now;
                                var statusLabel = isOpen ? "نشط" : "مغلق";
                                var statusClass = isOpen ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger";
                            }
                            <span class="badge @statusClass rounded-pill px-3">
                                <i class="bi bi-circle-fill ms-1" style="font-size: 0.4rem;"></i> @statusLabel
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-controller="Applications" asp-route-id="@app.Id"
                               class="btn btn-primary btn-sm rounded-pill px-4">
                                <i class="bi bi-people-fill ms-1"></i> عرض المتقدمين
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>