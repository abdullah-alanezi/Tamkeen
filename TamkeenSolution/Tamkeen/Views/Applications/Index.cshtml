@model List<Tamkeen.Domain.Entities.ProgramPost>

<h2>Applications</h2>



<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Capacity</th>
           
            <th>End Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model)
        {
            <tr>
                <td>@app.trainingProgram.Name</td>
                
                <td>@app.trainingProgram.Capacity</td>
                <td>@app.trainingProgram.EndDate</td>
                <td>
                    <a asp-action="Details" asp-controller="Applications" asp-route-id="@app.Id" class="btn btn-info btn-sm">Details</a>
                    
                </td>
            </tr>
        }
    </tbody>
</table>
