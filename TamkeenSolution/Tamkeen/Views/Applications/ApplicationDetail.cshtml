@model Tamkeen.Domain.Entities.Application

@{
    ViewData["Title"] = "مراجعة طلب المتقدم";
}

<div class="container py-5 text-end">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="card-header bg-primary bg-gradient p-4 border-0">
                    <div class="d-flex align-items-center">
                        <div class="bg-white rounded-circle p-3 shadow-sm ms-4">
                            <i class="bi bi-person-badge text-primary fs-1"></i>
                        </div>
                        <div class="text-white">
                            <h2 class="mb-1 fw-bold">@Model.FullName</h2>
                            <p class="mb-0 opacity-75 d-flex align-items-center">
                                <i class="bi bi-envelope-at ms-2"></i> @Model.Email
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-md-7 p-4 border-start bg-light-subtle">
                            <h6 class="text-uppercase text-muted small fw-bold mb-4 border-bottom pb-2">التفاصيل الأكاديمية</h6>

                            <div class="row g-3">
                                <div class="col-sm-6 mb-4">
                                    <label class="text-muted small d-block">الجامعة</label>
                                    <span class="fw-bold fs-5 text-dark">@Model.University</span>
                                </div>

                                <div class="col-sm-6 mb-4">
                                    <label class="text-muted small d-block">التخصص</label>
                                    <span class="fw-bold fs-5 text-dark">@Model.Major</span>
                                </div>
                            </div>

                            <div class="p-3 rounded-4 border bg-white shadow-sm mb-4">
                                <label class="text-muted small d-block mb-2">المستندات المرفقة</label>
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-file-pdf text-danger fs-3 ms-2"></i>
                                        <span class="text-dark fw-medium">السيرة الذاتية (CV)</span>
                                    </div>
                                    <a href="/uploads/@Model.CVPath" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-4">
                                        <i class="bi bi-eye me-1"></i> عرض الملف
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5 p-4 bg-white">
                            <h6 class="text-uppercase text-muted small fw-bold mb-4 border-bottom pb-2">إجراءات الإدارة</h6>

                            <form asp-action="UpdateStatus" method="post">
                                <input type="hidden" asp-for="Id" />

                                <div class="p-4 rounded-4 border bg-light mb-4 text-center">
                                    <label class="small text-muted mb-2 d-block">الحالة الحالية</label>
                                    @{
                                        var statusClass = GetStatusClass(Model.Status);
                                        var statusText = GetStatusArabicText(Model.Status);
                                    }
                                    <span class="badge rounded-pill @statusClass px-4 py-2 fs-6 shadow-sm">
                                        @statusText
                                    </span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Status" class="form-label fw-bold text-secondary">تعديل الحالة إلى:</label>
                                    <select asp-for="Status"
                                            class="form-select form-select-lg shadow-sm border-primary-subtle rounded-3"
                                            asp-items="Html.GetEnumSelectList<Tamkeen.Domain.Enums.ApplicationStatus>()">
                                    </select>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow rounded-pill">
                                    <i class="bi bi-check2-circle ms-2"></i> تحديث حالة الطلب
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

            </div>

            <div class="text-center mt-4">
                <a asp-action="Details" asp-controller="Applications" asp-route-id="@Model.programPostId" class="btn btn-link text-decoration-none text-muted">
                    <i class="bi bi-arrow-right ms-1"></i> العودة لقائمة المتقدمين
                </a>
            </div>
        </div>
    </div>
</div>

@functions {
    // تنسيق ألوان الـ Badge بناءً على Enum المتقدمين
    string GetStatusClass(Tamkeen.Domain.Enums.ApplicationStatus status)
    {
        return status switch
        {
            Tamkeen.Domain.Enums.ApplicationStatus.Accepted => "bg-success text-white",
            Tamkeen.Domain.Enums.ApplicationStatus.Pending => "bg-warning text-dark",
            Tamkeen.Domain.Enums.ApplicationStatus.UnderReview => "bg-info text-white",
            Tamkeen.Domain.Enums.ApplicationStatus.Rejected => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }

    // تحويل الـ Enum لنص عربي للعرض فقط
    string GetStatusArabicText(Tamkeen.Domain.Enums.ApplicationStatus status)
    {
        return status switch
        {
            Tamkeen.Domain.Enums.ApplicationStatus.Pending => "قيد الانتظار",
            Tamkeen.Domain.Enums.ApplicationStatus.UnderReview => "تحت المراجعة",
            Tamkeen.Domain.Enums.ApplicationStatus.Accepted => "مقبول",
            Tamkeen.Domain.Enums.ApplicationStatus.Rejected => "مرفوض",
            _ => "غير معروف"
        };
    }
}

<style>
    .bg-primary {
        background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%) !important;
    }

    .card {
        transition: all 0.3s ease;
    }

    .form-select:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.1);
    }
</style>