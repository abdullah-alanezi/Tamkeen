@using Tamkeen.Models.ModelsView
@model IEnumerable<UserRolesViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary font-weight-bold">Tamkeen | User Management</h2>
        <span class="badge bg-secondary">Total Users: @Model.Count()</span>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Username</th>
                        <th>Email Address</th>
                        <th>Current Role</th>
                        <th>Change Role</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4 align-middle font-weight-bold">@user.UserName</td>
                            <td class="align-middle">@user.Email</td>
                            <td class="align-middle">
                                <span class="badge rounded-pill @(user.CurrentRole == "Admin" ? "bg-danger" : "bg-info text-dark")">
                                    @user.CurrentRole
                                </span>
                            </td>
                            <td class="align-middle">
                                <form asp-action="ChangeRole" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <select name="newRole" class="form-select form-select-sm w-auto">
                                        @foreach (var role in user.AllRoles)
                                        {
                                            <option value="@role" selected="@(role == user.CurrentRole)">@role</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-success">Update</button>
                                </form>
                            </td>
                            <td class="align-middle text-center">
                                <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>