@model Tamkeen.Domain.Entities.TrainingProgram

@{
    ViewData["Title"] = "تفاصيل البرنامج";

    // منطق حساب حالة البرنامج لعام 2026
    var today = DateTime.Now;
    var statusLabel = "قادم";
    var statusClass = "bg-primary-subtle text-primary";

    if (today >= Model.StartDate && today <= Model.EndDate)
    {
        statusLabel = "جاري الآن";
        statusClass = "bg-success-subtle text-success";
    }
    else if (today > Model.EndDate)
    {
        statusLabel = "مكتمل";
        statusClass = "bg-secondary-subtle text-secondary";
    }
}

<style>
    .program-hero {
        background: #ffffff;
        border-radius: 1.5rem;
        border: 1px solid #eef2f7;
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
    }

    .timeline-strip {
        background: #f8f9fa;
        border-radius: 1.25rem;
        padding: 1.75rem;
        border: 1px solid #edf2f7;
    }

    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .description-text {
        font-size: 1.1rem;
        line-height: 1.9;
        color: #4a5568;
        text-align: justify;
    }

    .data-label {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        color: #94a3b8;
        letter-spacing: 0.5px;
    }

    .btn-quick-action {
        transition: all 0.2s;
        border: 1px solid rgba(255,255,255,0.1) !important;
    }

        .btn-quick-action:hover {
            background: rgba(255,255,255,0.1);
            transform: translateX(-5px);
        }
</style>

<div class="container py-4 text-end">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <a asp-action="Index" class="btn btn-white shadow-sm rounded-pill px-4 border">
            <i class="bi bi-arrow-right ms-2"></i>العودة للبرامج
        </a>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-pencil ms-2"></i>تعديل البيانات
            </a>
            <button class="btn btn-dark rounded-pill px-4 shadow-sm">
                <i class="bi bi-share ms-2"></i>مشاركة
            </button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="program-hero p-4 p-md-5">
                <div class="mb-4">
                    <span class="badge @statusClass rounded-pill px-3 py-2 mb-3">
                        <i class="bi bi-circle-fill ms-1" style="font-size: 0.5rem;"></i> @statusLabel
                    </span>
                    <h1 class="fw-bold text-dark mb-3">@Model.Name</h1>
                </div>

                <div class="mb-5">
                    <h6 class="data-label mb-3">وصف البرنامج التدريبي</h6>
                    <div class="description-text">
                        @Model.Description
                    </div>
                </div>

                <div class="timeline-strip">
                    <div class="row align-items-center">
                        <div class="col-md-5 text-center text-md-end">
                            <span class="data-label d-block mb-1">تاريخ البدء</span>
                            <span class="h5 fw-bold text-dark">
                                <i class="bi bi-calendar-event ms-2 text-primary"></i>
                                @Model.StartDate.ToString("dd MMMM, yyyy")
                            </span>
                        </div>
                        <div class="col-md-2 text-center py-3 py-md-0">
                            <i class="bi bi-arrow-left text-muted d-none d-md-block fs-4"></i>
                            <i class="bi bi-arrow-down text-muted d-md-none fs-4"></i>
                        </div>
                        <div class="col-md-5 text-center text-md-start">
                            <span class="data-label d-block mb-1">تاريخ الانتهاء</span>
                            <span class="h5 fw-bold text-dark">
                                <i class="bi bi-calendar-check ms-2 text-success"></i>
                                @Model.EndDate.ToString("dd MMMM, yyyy")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h6 class="data-label mb-0">الطاقة الاستيعابية</h6>
                    <div class="icon-box bg-warning-subtle text-warning">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline">
                    <h2 class="fw-bold mb-0">@Model.Capacity</h2>
                    <span class="text-muted ms-2 me-2">مقعد متاح إجمالاً</span>
                </div>
                <div class="progress mt-4" style="height: 10px; border-radius: 5px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: 5%" aria-valuenow="5" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <p class="small text-muted mt-3 mb-0">
                    <i class="bi bi-info-circle ms-1"></i> التسجيل في مراحله الأولى حالياً.
                </p>
            </div>

            <div class="card border-0 bg-dark text-white rounded-4 p-4 shadow-lg">
                <h6 class="data-label text-white-50 mb-4">إجراءات إدارية سريعة</h6>
                <div class="d-grid gap-2">
                    <button class="btn btn-quick-action text-white text-end py-2 px-3 rounded-3">
                        <i class="bi bi-cloud-download ms-2 text-info"></i> تحميل الحقيبة التدريبية
                    </button>
                    <button class="btn btn-quick-action text-white text-end py-2 px-3 rounded-3">
                        <i class="bi bi-printer ms-2 text-secondary"></i> طباعة كشف الحضور
                    </button>
                    <div class="my-2 border-bottom border-secondary opacity-25"></div>
                    <button class="btn btn-quick-action text-danger text-end py-2 px-3 rounded-3 fw-bold">
                        <i class="bi bi-archive ms-2"></i> أرشفة البرنامج التدريبي
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>