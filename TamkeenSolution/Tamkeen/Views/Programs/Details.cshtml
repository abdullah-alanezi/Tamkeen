@model Tamkeen.Domain.Entities.TrainingProgram

@{
    ViewData["Title"] = "Program Overview";
    
    // Logic for 2026 Status Badge
    var today = DateTime.Now;
    var statusLabel = "Upcoming";
    var statusClass = "bg-primary-subtle text-primary";
    
    if (today >= Model.StartDate && today <= Model.EndDate) {
        statusLabel = "In Progress";
        statusClass = "bg-success-subtle text-success";
    } else if (today > Model.EndDate) {
        statusLabel = "Completed";
        statusClass = "bg-secondary-subtle text-secondary";
    }
}

<style>
    .program-hero {
        background: #ffffff;
        border-radius: 1.5rem;
        border: 1px solid #eef2f7;
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
    }
    
    .timeline-strip {
        background: #f8f9fa;
        border-radius: 1rem;
        padding: 1.5rem;
    }

    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .description-text {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #4a5568;
    }

    .data-label {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        color: #a0aec0;
        letter-spacing: 1px;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-light rounded-pill px-3 shadow-sm">
            <i class="bi bi-arrow-left me-2"></i>Back to Programs
        </a>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-pencil me-2"></i>Edit Program
            </a>
            <button class="btn btn-dark rounded-pill px-4">
                <i class="bi bi-share me-2"></i>Share
            </button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="program-hero p-4 p-md-5">
                <div class="mb-4">
                    <span class="badge @statusClass rounded-pill px-3 py-2 mb-3">
                        <i class="bi bi-dot"></i> @statusLabel
                    </span>
                    <h1 class="display-6 fw-bold text-dark mb-3">@Model.Name</h1>
                </div>

                <div class="mb-5">
                    <h6 class="data-label mb-3">Program Description</h6>
                    <div class="description-text">
                        @Model.Description
                    </div>
                </div>

                <div class="timeline-strip">
                    <div class="row align-items-center">
                        <div class="col-md-5 text-center text-md-start">
                            <span class="data-label d-block mb-1">Starts On</span>
                            <span class="h5 fw-bold text-dark"><i class="bi bi-calendar-event me-2 text-primary"></i>@Model.StartDate.ToString("MMMM dd, yyyy")</span>
                        </div>
                        <div class="col-md-2 text-center py-3 py-md-0">
                            <i class="bi bi-arrow-right text-muted d-none d-md-block fs-4"></i>
                            <i class="bi bi-arrow-down text-muted d-md-none fs-4"></i>
                        </div>
                        <div class="col-md-5 text-center text-md-end">
                            <span class="data-label d-block mb-1">Ends On</span>
                            <span class="h5 fw-bold text-dark"><i class="bi bi-calendar-check me-2 text-success"></i>@Model.EndDate.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h6 class="data-label mb-0">Program Capacity</h6>
                    <div class="icon-box bg-warning-subtle text-warning">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline">
                    <h2 class="fw-bold mb-0">@Model.Capacity</h2>
                    <span class="text-muted ms-2">Total Seats Available</span>
                </div>
                <div class="progress mt-4" style="height: 8px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <p class="small text-muted mt-3 mb-0">
                    <i class="bi bi-info-circle me-1"></i> Enrollment has not started yet.
                </p>
            </div>

            <div class="card border-0 bg-dark text-white rounded-4 p-4">
                <h6 class="data-label text-white-50 mb-3">Quick Management</h6>
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-light btn-sm text-start py-2 border-secondary">
                        <i class="bi bi-cloud-download me-2"></i> Download Syllabus
                    </button>
                    <button class="btn btn-outline-light btn-sm text-start py-2 border-secondary">
                        <i class="bi bi-printer me-2"></i> Print Attendance Sheet
                    </button>
                    <button class="btn btn-outline-danger btn-sm text-start py-2 mt-2">
                        <i class="bi bi-trash me-2"></i> Archive Program
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>