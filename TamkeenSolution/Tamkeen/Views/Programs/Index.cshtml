@model List<Tamkeen.Domain.Entities.TrainingProgram>

@{
    ViewData["Title"] = "Training Programs";
}



<div class="container-fluid py-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="fw-bold text-dark mb-1">Training Programs</h2>
            <p class="text-muted mb-0">Manage, monitor, and publish your educational tracks.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary btn-action shadow-sm">
                <i class="bi bi-plus-lg"></i> Create Program
            </a>
        </div>
    </div>

    <div class="card card-custom">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Program Name</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Capacity</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var program in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold text-dark">@program.Name</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-calendar3 text-muted me-2"></i>
                                            @program.StartDate.ToShortDateString()
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-calendar-check text-muted me-2"></i>
                                            @program.EndDate.ToShortDateString()
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border status-badge">
                                            <i class="bi bi-people-fill me-1"></i> @program.Capacity
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group gap-2">

                                            @if (program.is_posted)
                                            {
                                                <a asp-action="Details" asp-route-id="@program.Id" class="btn btn-primary btn-sm rounded-pill px-3 btn-action">
                                                    <i class="bi bi-cloud-check"></i> Posted
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="Post" asp-controller="Applications" asp-route-id="@program.Id" class="btn btn-outline-success btn-sm btn-action">
                                                    <i class="bi bi-send-fill"></i> Post
                                                </a>
                                            }
        
                                            <a asp-action="Details" asp-route-id="@program.Id" class="btn btn-outline-info btn-sm btn-action">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@program.Id" class="btn btn-outline-warning btn-sm btn-action text-dark">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-folder2-open display-1 text-muted"></i>
                    </div>
                    <h4 class="text-secondary">No programs found</h4>
                    <p class="text-muted">It looks like you haven't created any training programs yet.</p>
                    <a asp-action="Create" class="btn btn-primary mt-2">
                        Get Started
                    </a>
                </div>
            }
        </div>
    </div>
</div>