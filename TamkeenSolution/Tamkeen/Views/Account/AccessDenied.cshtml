@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center" style="margin-top: 100px; max-width: 600px;">
    <div class="card shadow-sm border-0 py-5">
        <div class="card-body">
            <div class="mb-4">
                <i class="bi bi-shield-lock text-danger" style="font-size: 4rem;"></i>
            </div>

            <h1 class="fw-bold text-dark">Access Denied</h1>

            <p class="text-muted fs-5 mt-3">
                You do not have the necessary permissions to view this page within the <strong>Tamkeen</strong> platform.
            </p>

            <hr class="my-4 mx-auto" style="width: 50%;">

            <p class="small text-secondary">
                If you believe this is an error, please contact your System Administrator
                or your department head to request the required access levels.
            </p>

            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary btn-lg px-4 me-2">
                    Back to Home
                </a>
                <a href="mailto:admin@tamkeen.com" class="btn btn-primary btn-lg px-4">
                    Contact Support
                </a>
            </div>
        </div>
    </div>
</div>