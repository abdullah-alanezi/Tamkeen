@model Tamkeen.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "إنشاء حساب جديد";
    Layout = "_AuthLayout";
}

<div class="container mt-5 mb-5 text-end">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden animate__animated animate__fadeInUp">
                <div class="card-header bg-primary py-4 text-center border-0">
                    <h3 class="text-white mb-0 fw-bold">انضم إلى تمكين</h3>
                    <p class="text-white opacity-75 small mb-0 mt-1">ابدأ رحلتك المهنية وعزز مهاراتك معنا</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 border-0 rounded-3"></div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label fw-semibold text-secondary">اسم المستخدم</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-start-0 rounded-end-3"><i class="bi bi-person text-muted"></i></span>
                                <input asp-for="UserName" class="form-control border-end-0 ps-0 bg-light rounded-start-3 text-start" dir="ltr" placeholder="مثال: Ahmad_2026" />
                            </div>
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary">البريد الإلكتروني</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-start-0 rounded-end-3"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" class="form-control border-end-0 ps-0 bg-light rounded-start-3 text-start" dir="ltr" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3 text-end">
                                <label asp-for="Password" class="form-label fw-semibold text-secondary">كلمة المرور</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-start-0 rounded-end-3"><i class="bi bi-lock text-muted"></i></span>
                                    <input asp-for="Password" type="password" class="form-control border-end-0 ps-0 bg-light rounded-start-3 text-start" dir="ltr" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4 text-end">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary">تأكيد الكلمة</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-start-0 rounded-end-3"><i class="bi bi-shield-check text-muted"></i></span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control border-end-0 ps-0 bg-light rounded-start-3 text-start" dir="ltr" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow py-3 fw-bold mb-3">
                            إنشاء حسابي الآن
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <p class="mb-0 text-muted">
                            لديك حساب بالفعل؟
                            <a asp-action="Login" class="text-primary fw-bold text-decoration-none border-bottom border-primary border-2">تسجيل الدخول</a>
                        </p>
                    </div>
                </div>
            </div>
            <p class="text-center text-muted mt-4 small">جميع الحقوق محفوظة © 2026 منصة تمكين</p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .bg-primary {
        background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%) !important;
    }

    .form-control:focus {
        background-color: #fff !important;
        border-color: #4f46e5;
        box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.1);
    }

    .input-group-text {
        border-color: #dee2e6;
    }
    /* تحسين شكل التنبيهات */
    .alert-danger {
        font-size: 0.85rem;
        border-right: 4px solid #dc3545;
    }
</style>