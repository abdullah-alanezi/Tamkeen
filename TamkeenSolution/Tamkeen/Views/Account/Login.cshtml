@model Tamkeen.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "_AuthLayout";
}

<div class="container mt-5 mb-5 text-end">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden animate__animated animate__fadeIn">
                <div class="card-header bg-primary py-4 text-center border-0">
                    <h3 class="text-white mb-0 fw-bold">مرحباً بعودتك</h3>
                </div>

                <div class="card-body p-4 p-md-5">
                    <p class="text-center text-muted mb-4">الرجاء إدخال بياناتك للوصول إلى حسابك في تمكين</p>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 border-0 rounded-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">البريد الإلكتروني</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-start-0 rounded-end-3"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" class="form-control border-end-0 ps-0 bg-light rounded-start-3 text-start" dir="ltr" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">كلمة المرور</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-start-0 rounded-end-3"><i class="bi bi-lock text-muted"></i></span>
                                <input asp-for="Password" class="form-control border-end-0 ps-0 bg-light rounded-start-3 text-start" dir="ltr" placeholder="أدخل كلمة المرور" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4 px-1">
                            <div class="form-check p-0 ms-4">
                                <input asp-for="RememberMe" class="form-check-input float-none ms-2" />
                                <label asp-for="RememberMe" class="form-check-label small text-muted">تذكرني</label>
                            </div>
                            <a href="#" class="small text-decoration-none text-primary fw-medium">نسيت كلمة المرور؟</a>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm py-3 fw-bold">
                            <i class="bi bi-box-arrow-in-left ms-2"></i> دخول
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <p class="mb-0 text-muted">
                            جديد في تمكين؟
                            <a asp-action="Register" class="text-primary fw-bold text-decoration-none border-bottom border-primary border-2">إنشاء حساب جديد</a>
                        </p>
                    </div>
                </div>
            </div>

            <p class="text-center text-muted mt-4 small">© 2026 منصة تمكين. نظام دخول آمن ومحمي.</p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    /* لمسة جمالية للإدخال */
    .form-control:focus {
        background-color: #fff !important;
        box-shadow: none;
        border-color: #4f46e5;
    }

    .input-group-text {
        border-color: #dee2e6;
    }

    .bg-primary {
        background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%) !important;
    }
</style>