<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام تمكين</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --sidebar-width: 280px;
            --main-bg: #f8fafc;
            --tk-primary: #1e3a8a;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background-color: var(--main-bg);
            overflow-x: hidden;
        }

        /* حاوية النظام بالكامل */
        .app-container {
            display: flex;
            min-height: 100vh;
        }

        /* مساحة المحتوى الرئيسي */
        .main-content {
            flex-grow: 1;
            margin-right: var(--sidebar-width); /* حجز مكان السايد بار في اليمين */
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            min-width: 0; /* لمنع تمدد العناصر داخل الـ Flex */
        }

        /* الجزء الخاص بالمحتوى المتغير */
        .page-body {
            padding: 2rem;
            flex-grow: 1;
        }

        /* Responsive: الموبايل والتابلت */
        @@media (max-width: 991.98px) {
            .main-content {
                margin-right: 0; /* إلغاء الهامش في الشاشات الصغيرة */
            }

            .sidebar {
                transform: translateX(100%); /* إخفاء السايد بار لليمين */
                position: fixed;
            }

                .sidebar.active {
                    transform: translateX(0);
                }
        }
    </style>
</head>
<body>

    <div class="app-container">
        @await Html.PartialAsync("_Sidebar")

        <div class="main-content">
            @await Html.PartialAsync("_Navbar")

            <main class="page-body">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>

            <footer class="py-4 bg-white border-top text-center text-muted mt-auto">
                <small>&copy; 2026 جميع الحقوق محفوظة لـ <strong>منصة تمكين</strong></small>
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // وظيفة فتح/إغلاق السايد بار في الموبايل
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_NotificationPartial");
</body>
</html>