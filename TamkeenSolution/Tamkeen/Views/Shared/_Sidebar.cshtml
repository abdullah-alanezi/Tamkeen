<div class="sidebar d-flex flex-column shadow-lg" id="sidebar">
    <div class="sidebar-header d-flex align-items-center justify-content-start py-5 px-4">
        <div class="logo-icon shadow-primary rounded-3 ms-3 d-flex align-items-center justify-content-center"
             style="width: 42px; height: 42px; background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
            <i class="bi bi-layers-half text-white fs-4"></i>
        </div>
        <span class="fs-3 fw-bold text-white tracking-tight">تمكين</span>
    </div>

    <div class="sidebar-content flex-grow-1 px-3 overflow-y-auto">

        <small class="text-uppercase fw-bold mb-3 d-block ps-3 text-emerald-500"
               style="font-size: 0.7rem; letter-spacing: 0.05rem; opacity: 0.8;">القائمة الرئيسية</small>

        <nav class="nav flex-column gap-2">
            <a asp-controller="Dashboard" asp-action="Index" class="nav-link sidebar-link active">
                <i class="bi bi-grid-1x2-fill ms-3"></i>
                <span>لوحة التحكم</span>
            </a>

            <a asp-controller="Programs" asp-action="Index" class="nav-link sidebar-link">
                <i class="bi bi-journal-code ms-3"></i>
                <span>البرامج التطويرية</span>
            </a>

            <a asp-controller="Trainees" asp-action="Index" class="nav-link sidebar-link">
                <i class="bi bi-people-fill ms-3"></i>
                <span>المتدربين</span>
            </a>
        </nav>

        <small class="text-uppercase text-muted fw-bold mt-5 mb-3 d-block ps-3"
               style="font-size: 0.7rem; letter-spacing: 0.05rem; opacity: 0.6;">الإدارة والعمليات</small>

        <nav class="nav flex-column gap-2">
            <a asp-controller="Applications" asp-action="Index" class="nav-link sidebar-link d-flex align-items-center">
                <i class="bi bi-inbox-fill ms-3 text-emerald-400"></i>
                <span>طلبات الانضمام</span>
                <span class="badge rounded-pill bg-danger me-auto shadow-sm" style="font-size: 0.7rem; padding: 0.4em 0.8em;">5</span>
            </a>

            <a asp-controller="Evaluations" asp-action="Index" class="nav-link sidebar-link">
                <i class="bi bi-star-fill ms-3 text-warning"></i>
                <span>التقييمات</span>
            </a>
        </nav>
    </div>

    <div class="sidebar-footer p-3 mt-auto border-top border-white border-opacity-10 bg-black bg-opacity-10">
        <a asp-controller="User" asp-action="Index" class="nav-link sidebar-link mb-3">
            <i class="bi bi-gear-fill ms-3"></i>
            <span>الإعدادات</span>
        </a>

        <div class="d-flex align-items-center p-3 rounded-4" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
            <div class="flex-shrink-0 me-1">
                <div class="status-pulse"></div>
            </div>
            <div class="flex-grow-1 me-3">
                <div class="text-white opacity-75 fw-medium" style="font-size: 0.8rem;">النظام متصل حالياً</div>
            </div>
        </div>
    </div>
</div>

<style>
    /* تحسينات الـ Sidebar */
    .sidebar {
        background: #0f172a; /* لون Slate داكن جداً */
        border-left: 1px solid rgba(255,255,255,0.05);
    }

    .sidebar-link {
        color: #94a3b8 !important;
        font-weight: 500;
        padding: 12px 16px !important;
        border-radius: 12px !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
    }

        .sidebar-link i {
            font-size: 1.2rem;
        }

        .sidebar-link:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white !important;
            transform: translateX(-5px); /* تحريك طفيف لليمين في وضع RTL */
        }

        .sidebar-link.active {
            background: linear-gradient(90deg, rgba(16, 185, 129, 0.2) 0%, rgba(16, 185, 129, 0) 100%);
            color: #10b981 !important;
            position: relative;
        }

            /* المؤشر الضوئي الجانبي للعنصر النشط */
            .sidebar-link.active::after {
                content: "";
                position: absolute;
                right: 0;
                top: 20%;
                height: 60%;
                width: 4px;
                background: #10b981;
                border-radius: 4px 0 0 4px;
                box-shadow: -2px 0 10px rgba(16, 185, 129, 0.5);
            }

    .text-emerald-500 {
        color: #10b981;
    }

    /* أنيميشن النبض للحالة */
    .status-pulse {
        width: 10px;
        height: 10px;
        background: #10b981;
        border-radius: 50%;
        position: relative;
    }

        .status-pulse::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: #10b981;
            animation: pulse-ring 2s infinite;
        }

    @@keyframes pulse-ring {
        0% {
            transform: scale(0.5);
            opacity: 0.8;
        }

        100% {
            transform: scale(2.5);
            opacity: 0;
        }
    }

    /* تحسين السكرول بار الصغير */
    .sidebar-content::-webkit-scrollbar {
        width: 4px;
    }

    .sidebar-content::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.1);
        border-radius: 10px;
    }
</style>