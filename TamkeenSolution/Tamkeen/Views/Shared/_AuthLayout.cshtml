<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - تمكين</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e9f2 100%);
            min-height: 100vh;
        }

        .navbar {
            background-color: rgba(255, 255, 255, 0.8) !important;
            backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .nav-link {
            font-weight: 600;
            color: #4a5568 !important;
            transition: 0.3s;
        }

            .nav-link:hover {
                color: #4f46e5 !important;
            }

        .btn-register {
            background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
            border: none;
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light sticky-top mb-0 py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-3 text-primary" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-rocket-takeoff ms-2"></i>تمكين
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li class="nav-item"><a class="nav-link px-3" asp-controller="Applications" asp-action="UserApply">فرص التدريب</a></li>
                        <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="About">عن تمكين</a></li>
                    </ul>
                    <div class="d-flex gap-2 align-items-center">
                        <a class="nav-link px-4" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                        <a class="btn btn-primary btn-register text-white px-4 rounded-pill fw-bold" asp-controller="Account" asp-action="Register">ابدأ الآن</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="py-4 text-center text-muted border-top bg-white mt-5">
        <div class="container">
            <small>&copy; 2026 - نظام تمكين للتدريب التعاوني - جميع الحقوق محفوظة</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_NotificationPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>